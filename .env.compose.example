# docker-compose.yml takes its values from .env.compose (gitignored, never commit it), passed to every command:
#   docker compose --env-file .env.compose up -d --build
# cp .env.compose.example .env.compose, then replace every change-me and fill every empty secret. Each service gets
# only the keys docker-compose.yml lists for it. Random values: openssl rand -hex 32 (hex needs no URL-encoding in
# the database URLs and holds no `$`, which compose would read as a variable).

# Two database roles, two URLs:
# - POSTGRES_PASSWORD: the superuser `postgres`, owner of the schema; only the migrate service uses it
#   (MIGRATION_DATABASE_URL).
# - APP_DB_PASSWORD: the role `starterkit_app` (scripts/compose-app-role.sh creates it when the volume is new) with
#   SELECT/INSERT/UPDATE/DELETE only; the API connects as it (DATABASE_URL).
# Each URL repeats its password.
POSTGRES_PASSWORD=change-me-owner
APP_DB_PASSWORD=change-me-app
DATABASE_URL=postgresql://starterkit_app:change-me-app@postgres:5432/starterkit
MIGRATION_DATABASE_URL=postgresql://postgres:change-me-owner@postgres:5432/starterkit

# Shared by the API and the web: at least 32 characters.
INTERNAL_API_TOKEN=
# API: base64 of exactly 32 random bytes (openssl rand -base64 32).
DATA_ENCRYPTION_KEY=
# Web: seals the session cookie, at least 32 characters.
SESSION_SECRET=
# Web: the public origin users open (absolute og:image and icon URLs), e.g. https://app.example.com.
# Host port of the web (default 3001); APP_URL must match it.
WEB_PORT=3001
APP_URL=http://localhost:3001

# Production sends mail through SMTP over TLS: smtps://…:465 (TLS from the first byte) or smtp://…:587?requireTLS=true
# (STARTTLS, refused when the server doesn't offer it); plain smtp:// is refused in production.
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://user:change-me@smtp.example.com:587?requireTLS=true
MAIL_FROM=SunnyGo <noreply@example.com>
# Trial switch (off by default): true lets production run with MAIL_TRANSPORT=log; SMTP_URL and MAIL_FROM may then stay
# empty. No mail leaves the server (password reset and invitations reach nobody; the log has the subject only), and
# the API warns at boot. Turn it off and set SMTP before real use (docs/deploy.md).
# ALLOW_MAIL_LOG=false

# Web: true once the site is served over HTTPS; TRUSTED_PROXY=true behind a proxy that sets X-Forwarded-*.
# Required true when APP_URL uses HTTPS; false only for local HTTP.
# COOKIE_SECURE=false
# TRUSTED_PROXY=false

# Optional API sign-in methods; empty = off. Meanings and formats: apps/api/.env.example.
# Directory sign-in (production needs ldaps:// or LDAP_STARTTLS=true).
# LDAP_URL=ldaps://directory.example.com:636
# LDAP_BIND_DN=cn=app,dc=example,dc=com
# LDAP_BIND_PASSWORD=
# LDAP_BASE_DN=dc=example,dc=com
# LDAP_USER_FILTER=(uid={username})
# LDAP_STARTTLS=false
# Google and Apple: all of a provider's keys or none; redirect URI APP_URL/api/auth/oauth/<provider>/callback.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=com.example.app.signin
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# Optional job worker settings; empty = the default (apps/api/.env.example).
# WORKER_DB_POOL_MAX=10
# JOB_STATEMENT_TIMEOUT_MS=120000
# API and worker: folders file inbox sources read, absolute and comma-separated; empty = none. Both services mount
# INBOX_DIR (a host folder, default ./inbox) read-only at /data/inbox; another root needs its own mount in both.
# INBOX_ROOTS=/data/inbox
# INBOX_DIR=/srv/recon/inbox
# JOBS_POOL_MAX=3

# First Superadmin for `docker compose --env-file .env.compose run --rm migrate bun run db:seed` (password 12 to 128
# characters). Created once: skipped while an active Superadmin exists. Only the migrate service gets these.
SEED_SUPERADMIN_NAME=
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_USERNAME=
SEED_SUPERADMIN_PASSWORD=
# Optional: the default maker (`maker`, role Maker) and approver (`approver`, role Approver), each made once when its
# password is set (12 to 128 characters in production). Their space roles come from the local seed.
SEED_MAKER_PASSWORD=
SEED_APPROVER_PASSWORD=
# Trial switches (off by default): SEED_DEMO=true makes migrate run the demo seed after the system seed (once: skipped
# when its accounts exist): demo accounts, Treasury's BI-FAST sources, recons, runs, unmatch and an approval. It is
# refused under the image's NODE_ENV=production unless ALLOW_DEMO_SEED=true. The demo accounts share a known password
# (docs/deploy.md): change or deactivate them before any real use. Fake data only. SEED_SUPERADMIN_USERNAME must not be
# a demo username (superadmin, admin, viewer, ...): the demo seed stops with the name it found taken.
# SEED_DEMO=false
# ALLOW_DEMO_SEED=false
# Compose project (container, volume and image names); keeps this stack apart from another checkout.
COMPOSE_PROJECT_NAME=starterkit
