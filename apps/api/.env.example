# API settings (apps/api/src/kernel/config.ts). `bun run setup` writes apps/api/.env with random secrets; never commit it.

# Required
DATABASE_URL=postgresql://app_user:change-me@localhost:5432/app
# Shared with apps/web (.env.local): at least 32 characters.
INTERNAL_API_TOKEN=
# base64 of exactly 32 random bytes (encrypts TOTP secrets): openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# Optional (defaults shown)
# NODE_ENV=development
# API_HOST=127.0.0.1
# API_PORT=4000
# Schema owner for migrations; defaults to DATABASE_URL.
# MIGRATION_DATABASE_URL=
# DB_POOL_MAX=10
# The worker process (bun run worker): its job pool, the statement timeout of that pool, its /healthz port (on API_HOST).
# WORKER_DB_POOL_MAX=10
# JOB_STATEMENT_TIMEOUT_MS=120000
# WORKER_HEALTH_PORT=4100
# pg-boss's own pool (API and worker; 1 to 20).
# JOBS_POOL_MAX=3
# The DML-only role of DATABASE_URL: db:migrate grants it the rows of pg-boss's schema (pgboss), owned by the migrator.
# APP_DB_ROLE=
# SESSION_TTL_HOURS=12
# SESSION_IDLE_MINUTES=120
# The web app's address: links in emails and the OAuth redirect URIs (required in production).
# APP_URL=http://localhost:3000
# log | smtp (production requires smtp, with SMTP_URL and MAIL_FROM)
# MAIL_TRANSPORT=log
# A trial only: true lets production run with MAIL_TRANSPORT=log (no reset or invitation mail is sent; a warning at boot).
# ALLOW_MAIL_LOG=false
# Production refuses SMTP without TLS: smtps://…:465 is TLS from the first byte; smtp://…:587?requireTLS=true upgrades
# with STARTTLS and fails when the server doesn't offer it (plain smtp:// would send in clear text then).
# SMTP_URL=smtp://user:password@smtp.example.com:587?requireTLS=true
# MAIL_FROM=SunnyGo <noreply@example.com>
# AUDIT_RETENTION_DAYS=365
# Connector call log: rows kept this many days; their full (encrypted) request and response this many.
# CALL_LOG_RETENTION_DAYS=90
# CALL_LOG_FULL_RETENTION_DAYS=30
# Folders file inbox sources may read (and their subfolders): absolute paths, comma-separated; empty = none.
# INBOX_ROOTS=/data/inbox,/mnt/ksei
# The largest inbox upload in MB (Inbox files; 1 to 128, default 100).
# INBOX_UPLOAD_MAX_MB=100
# The largest Excel workbook a file source reads, in MB (1 to 128, default 50).
# EXCEL_MAX_MB=50
# How long a report file is kept (days), then removed by the janitor (DEC-060)
# REPORT_RETENTION_DAYS=400
# The Chromium that prints report PDFs in the worker (the API image's Debian package)
# REPORT_CHROMIUM_PATH=/usr/bin/chromium
# The Import section's staging database (DEC-066): the stg_* tables and import_file_history (recon_engine_import).
# Empty = the Import pages say staging isn't set up. The schema and history table of import-host; the role granted
# SELECT on a table created from the screen (empty = no grant); the pool size.
# STAGING_DATABASE_URL=postgres://user:password@host:5432/recon_engine_import
# STAGING_SCHEMA=public
# STAGING_HISTORY_TABLE=import_file_history
# STAGING_READONLY_ROLE=readonly
# STAGING_POOL_MAX=2
# LOG_LEVEL=info
# Mock Google/Apple and directory sign-in for development and tests; refused in production.
# OAUTH_MOCK=false
# LDAP_MOCK=false
# Directory sign-in (users marked LDAP): search LDAP_BASE_DN with LDAP_USER_FILTER as LDAP_BIND_DN, then bind as the
# entry found. Production needs ldaps:// or LDAP_STARTTLS=true.
# LDAP_URL=ldaps://directory.example.com:636
# LDAP_BIND_DN=cn=app,dc=example,dc=com
# LDAP_BIND_PASSWORD=
# LDAP_BASE_DN=dc=example,dc=com
# LDAP_USER_FILTER=(uid={username})
# LDAP_STARTTLS=false
# LDAP through the Bank Mega Open API gateway instead of LDAP_URL (not both): a Keycloak token (realm, password grant
# as the service account), then GET /openapi/v1.0/ldap/verifypassword/userid/<login>/password/<AES-256-CBC password>,
# signed with HMAC-SHA512 of the client secret. All of these but HOST, REALM and INSECURE_TLS are needed together.
# LDAP_GATEWAY_URL=https://openapi.example.com
# LDAP_GATEWAY_HOST=
# LDAP_GATEWAY_REALM=quarkus
# LDAP_GATEWAY_USERNAME=
# LDAP_GATEWAY_PASSWORD=
# LDAP_GATEWAY_CLIENT_ID=
# LDAP_GATEWAY_CLIENT_SECRET=
# LDAP_GATEWAY_SECRET_KEY=
# LDAP_GATEWAY_ENCRYPT_VERSION=v0.2
# LDAP_GATEWAY_PARTNER_ID=
# LDAP_GATEWAY_CHANNEL_ID=
# LDAP_GATEWAY_INSECURE_TLS=false
# Google and Apple sign-in: a provider is on when all of its keys are set. Register the redirect URI
# APP_URL/api/auth/oauth/google/callback (or .../apple/callback) with the provider.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=com.example.app.signin
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# The Sign in with Apple key (.p8), PKCS#8 PEM; write line breaks as \n on one line.
# APPLE_PRIVATE_KEY=

# First Superadmin that `bun run db:seed` creates while no active Superadmin exists (created once); empty = none.
SEED_SUPERADMIN_NAME=
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_USERNAME=
SEED_SUPERADMIN_PASSWORD=
# Optional: the default maker (`maker`, role Maker) and approver (`approver`, role Approver), each made once when its
# password is set (12 to 128 characters in production). Their space roles come from the local seed.
SEED_MAKER_PASSWORD=
SEED_APPROVER_PASSWORD=
# A trial only: true lets `bun run db:seed:demo` run under NODE_ENV=production (demo accounts with a known password).
# ALLOW_DEMO_SEED=false
