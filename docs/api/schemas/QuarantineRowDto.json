{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuarantineRowDto",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "origin": {
      "type": "string",
      "enum": [
        "file",
        "pull",
        "snapshot"
      ]
    },
    "originId": {
      "type": "string"
    },
    "file": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "line": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "raw": {
      "type": "string"
    },
    "reasons": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "businessDate": {
      "type": [
        "string",
        "null"
      ]
    },
    "createdAt": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "origin",
    "originId",
    "file",
    "line",
    "raw",
    "reasons",
    "businessDate",
    "createdAt"
  ],
  "additionalProperties": false
}
