{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConnectorCallRowDto",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "startedAt": {
      "type": "string"
    },
    "durationMs": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "connector": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "version": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "environment": {
      "type": "string",
      "enum": [
        "dev",
        "prod"
      ]
    },
    "operation": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "key",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "method": {
      "type": "string"
    },
    "host": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "ok",
        "rejected",
        "timeout",
        "not_sent"
      ]
    },
    "httpStatus": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "code": {
      "type": [
        "string",
        "null"
      ]
    },
    "message": {
      "type": [
        "string",
        "null"
      ]
    },
    "externalId": {
      "type": [
        "string",
        "null"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "origin": {
      "type": "object",
      "properties": {
        "module": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "refId": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": "string"
        },
        "href": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "module",
        "kind",
        "refId",
        "label",
        "href"
      ],
      "additionalProperties": false
    },
    "actor": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "onBehalfOf": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "full": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "startedAt",
    "durationMs",
    "connector",
    "version",
    "environment",
    "operation",
    "method",
    "host",
    "path",
    "outcome",
    "httpStatus",
    "code",
    "message",
    "externalId",
    "attempt",
    "origin",
    "actor",
    "onBehalfOf",
    "full"
  ],
  "additionalProperties": false
}
