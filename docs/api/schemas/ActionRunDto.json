{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ActionRunDto",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "posting",
        "notify"
      ]
    },
    "event": {
      "type": "string",
      "enum": [
        "level_approved",
        "approved",
        "rejected"
      ]
    },
    "level": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "variant": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "sending",
        "posted",
        "failed",
        "not_sent",
        "timeout",
        "no_rule",
        "skipped",
        "grouped"
      ]
    },
    "override": {
      "type": "boolean"
    },
    "code": {
      "type": [
        "string",
        "null"
      ]
    },
    "message": {
      "type": [
        "string",
        "null"
      ]
    },
    "bankReference": {
      "type": [
        "string",
        "null"
      ]
    },
    "externalId": {
      "type": [
        "string",
        "null"
      ]
    },
    "at": {
      "type": "string"
    },
    "payload": {
      "anyOf": [
        {},
        {
          "type": "null"
        }
      ]
    },
    "response": {
      "anyOf": [
        {},
        {
          "type": "null"
        }
      ]
    },
    "queuedAt": {
      "type": "string"
    },
    "sendingAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "finishedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "httpStatus": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "group": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "configId": {
              "type": "string"
            },
            "period": {
              "type": "string"
            },
            "keys": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  }
                },
                "required": [
                  "label",
                  "value"
                ],
                "additionalProperties": false
              }
            },
            "at": {
              "type": "string",
              "enum": [
                "cutoff",
                "day_close"
              ]
            },
            "closesAt": {
              "type": [
                "string",
                "null"
              ]
            },
            "items": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "id",
            "configId",
            "period",
            "keys",
            "at",
            "closesAt",
            "items"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "name",
    "kind",
    "event",
    "level",
    "variant",
    "status",
    "override",
    "code",
    "message",
    "bankReference",
    "externalId",
    "at",
    "payload",
    "response",
    "queuedAt",
    "sendingAt",
    "finishedAt",
    "httpStatus",
    "group"
  ],
  "additionalProperties": false
}
