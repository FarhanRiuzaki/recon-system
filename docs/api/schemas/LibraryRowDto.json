{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LibraryRowDto",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "levels": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "archived": {
      "type": "boolean"
    },
    "published": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "version": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "decidedAt": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "version",
            "decidedAt"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "open": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "version": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "status": {
              "type": "string",
              "enum": [
                "draft",
                "in_review"
              ]
            },
            "updatedAt": {
              "type": "string"
            }
          },
          "required": [
            "version",
            "status",
            "updatedAt"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "reconsUsing": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "levels",
    "archived",
    "published",
    "open",
    "reconsUsing",
    "updatedAt"
  ],
  "additionalProperties": false
}
