{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceHealthDto",
  "type": "object",
  "properties": {
    "state": {
      "type": "string",
      "enum": [
        "healthy",
        "degraded",
        "down"
      ]
    },
    "businessDate": {
      "type": "string"
    },
    "lagSeconds": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "completeThrough": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "missingDate": {
      "type": [
        "string",
        "null"
      ]
    },
    "lastError": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "state",
    "businessDate",
    "lagSeconds",
    "completeThrough",
    "reason",
    "missingDate",
    "lastError"
  ],
  "additionalProperties": false
}
