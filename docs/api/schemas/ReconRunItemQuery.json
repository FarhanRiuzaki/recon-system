{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReconRunItemQuery",
  "type": "object",
  "properties": {
    "page": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "pageSize": {
      "default": 15,
      "enum": [
        15,
        25,
        50,
        100
      ],
      "type": "number"
    },
    "sort": {
      "type": "string",
      "enum": [
        "businessDate",
        "-businessDate"
      ]
    },
    "pass": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "matched",
        "suggested",
        "break",
        "closed",
        "not_required"
      ]
    },
    "side": {
      "type": "string",
      "enum": [
        "a",
        "b"
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "reason": {
      "type": "string",
      "enum": [
        "Duplicate",
        "Ambiguous",
        "Currency differs",
        "Amount differs",
        "Date differs",
        "No counterpart",
        "Unconfirmed suggestion"
      ]
    },
    "dates": {
      "type": "string",
      "enum": [
        "own",
        "carried"
      ]
    }
  }
}
