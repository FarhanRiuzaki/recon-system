{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceSnapshotPage",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "businessDate": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "loading",
              "active",
              "failed",
              "superseded"
            ]
          },
          "rows": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "startedAt": {
            "type": "string"
          },
          "finishedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "closed": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "businessDate",
          "status",
          "rows",
          "error",
          "startedAt",
          "finishedAt",
          "closed"
        ],
        "additionalProperties": false
      }
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "pageSize": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "totalCapped": {
      "type": "boolean"
    }
  },
  "required": [
    "items",
    "total",
    "page",
    "pageSize"
  ],
  "additionalProperties": false
}
