{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PreviewRulesBody",
  "type": "object",
  "properties": {
    "spec": {
      "type": "object",
      "properties": {
        "rules": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "when": {
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "attr": {
                      "type": "string",
                      "enum": [
                        "amount",
                        "currency",
                        "recon",
                        "ageDays"
                      ]
                    },
                    "op": {
                      "type": "string",
                      "enum": [
                        "gte",
                        "gt",
                        "lte",
                        "lt",
                        "eq",
                        "in",
                        "not_in"
                      ]
                    },
                    "value": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        {
                          "minItems": 1,
                          "maxItems": 20,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64
                          }
                        }
                      ]
                    }
                  },
                  "required": [
                    "attr",
                    "op",
                    "value"
                  ],
                  "additionalProperties": false
                }
              },
              "workflowId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              }
            },
            "required": [
              "name",
              "when",
              "workflowId"
            ],
            "additionalProperties": false
          }
        },
        "otherwise": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "rules",
        "otherwise"
      ],
      "additionalProperties": false
    },
    "attributes": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^\\d{1,18}$"
        },
        "currency": {
          "type": "string",
          "maxLength": 8
        },
        "recon": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "ageDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "attributes"
  ],
  "additionalProperties": false
}
