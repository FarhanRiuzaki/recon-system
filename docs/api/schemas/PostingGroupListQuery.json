{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PostingGroupListQuery",
  "type": "object",
  "properties": {
    "page": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "pageSize": {
      "default": 15,
      "enum": [
        15,
        25,
        50,
        100
      ],
      "type": "number"
    },
    "q": {
      "type": "string",
      "maxLength": 200
    },
    "sort": {
      "type": "string",
      "enum": [
        "period",
        "-period"
      ]
    },
    "status": {
      "anyOf": [
        {
          "type": "string",
          "const": ""
        },
        {
          "type": "string",
          "enum": [
            "open",
            "closed"
          ]
        },
        {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "open",
              "closed"
            ]
          }
        }
      ]
    }
  }
}
