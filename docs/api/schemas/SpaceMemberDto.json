{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpaceMemberDto",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "space_admin",
          "source_admin",
          "config_maker",
          "config_checker",
          "operator",
          "reviewer",
          "viewer"
        ]
      }
    },
    "active": {
      "type": "boolean"
    },
    "lastSignInAt": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "userId",
    "name",
    "username",
    "roles",
    "active",
    "lastSignInAt"
  ],
  "additionalProperties": false
}
