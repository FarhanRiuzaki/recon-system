{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SaveConnectorBody",
  "type": "object",
  "properties": {
    "spec": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "profile": {
          "type": "string",
          "enum": [
            "bank_mega_openapi_2_1"
          ]
        },
        "active": {
          "type": "string",
          "enum": [
            "dev",
            "prod"
          ]
        },
        "environments": {
          "type": "object",
          "properties": {
            "dev": {
              "type": "object",
              "properties": {
                "baseUrl": {
                  "type": "string",
                  "maxLength": 300
                },
                "host": {
                  "type": "string",
                  "maxLength": 200
                },
                "partnerId": {
                  "type": "string",
                  "maxLength": 64
                },
                "channelId": {
                  "type": "string",
                  "maxLength": 64
                },
                "verifyTls": {
                  "default": false,
                  "type": "boolean"
                }
              },
              "required": [
                "baseUrl",
                "host",
                "partnerId",
                "channelId"
              ],
              "additionalProperties": false
            },
            "prod": {
              "type": "object",
              "properties": {
                "baseUrl": {
                  "type": "string",
                  "maxLength": 300
                },
                "host": {
                  "type": "string",
                  "maxLength": 200
                },
                "partnerId": {
                  "type": "string",
                  "maxLength": 64
                },
                "channelId": {
                  "type": "string",
                  "maxLength": 64
                },
                "verifyTls": {
                  "default": false,
                  "type": "boolean"
                }
              },
              "required": [
                "baseUrl",
                "host",
                "partnerId",
                "channelId"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "dev",
            "prod"
          ],
          "additionalProperties": false
        },
        "operations": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,39}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "method": {
                "type": "string",
                "enum": [
                  "POST",
                  "GET",
                  "PUT"
                ]
              },
              "path": {
                "type": "string",
                "maxLength": 300,
                "pattern": "^\\/[^\\s]*$"
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 60000
              },
              "request": {
                "maxItems": 400,
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              "response": {
                "maxItems": 400,
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              "success": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "field": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      },
                      "equals": {
                        "type": "string",
                        "maxLength": 40
                      }
                    },
                    "required": [
                      "field",
                      "equals"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reference": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "masked": {
                "maxItems": 400,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              },
              "presets": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "additionalProperties": {
                  "type": "string",
                  "maxLength": 500
                }
              },
              "auto": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "external_id"
                        }
                      },
                      "required": [
                        "kind"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "now"
                        },
                        "format": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 60
                        }
                      },
                      "required": [
                        "kind",
                        "format"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            },
            "required": [
              "key",
              "name",
              "method",
              "path",
              "timeoutMs",
              "request",
              "response",
              "success",
              "reference",
              "masked",
              "presets"
            ],
            "additionalProperties": false
          }
