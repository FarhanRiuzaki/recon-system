{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImportCheckDto",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "at": {
      "type": "string"
    },
    "trigger": {
      "type": "string",
      "enum": [
        "schedule",
        "manual"
      ]
    },
    "result": {
      "type": "string",
      "enum": [
        "not_ready",
        "imported",
        "skipped",
        "failed",
        "dry_run"
      ]
    },
    "rows": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "inserted": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "replaced": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "historyId": {
      "type": [
        "string",
        "null"
      ]
    },
    "message": {
      "type": [
        "string",
        "null"
      ]
    },
    "by": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "date",
    "at",
    "trigger",
    "result",
    "rows",
    "inserted",
    "replaced",
    "historyId",
    "message",
    "by"
  ],
  "additionalProperties": false
}
