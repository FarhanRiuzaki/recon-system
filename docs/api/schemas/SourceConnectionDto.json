{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceConnectionDto",
  "type": "object",
  "properties": {
    "engine": {
      "type": "string",
      "enum": [
        "postgres",
        "mysql",
        "mssql",
        "oracle"
      ]
    },
    "options": {
      "type": "object",
      "properties": {
        "tls": {
          "default": false,
          "type": "boolean"
        },
        "connectTimeoutSeconds": {
          "default": 15,
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        }
      },
      "required": [
        "tls",
        "connectTimeoutSeconds"
      ],
      "additionalProperties": false
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "required": [
    "engine",
    "options",
    "updatedAt"
  ],
  "additionalProperties": false
}
