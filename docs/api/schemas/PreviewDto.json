{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PreviewDto",
  "type": "object",
  "properties": {
    "rule": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "index": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "index"
      ],
      "additionalProperties": false
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "need": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "any",
                        "all",
                        "count"
                      ]
                    },
                    "n": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false
                },
                "approvers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "name"
                    ],
                    "additionalProperties": false
                  }
                },
                "short": {
                  "type": "boolean"
                }
              },
              "required": [
                "need",
                "approvers",
                "short"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "groups"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "rule",
    "levels"
  ],
  "additionalProperties": false
}
