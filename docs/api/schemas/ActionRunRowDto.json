{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ActionRunRowDto",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "posting",
        "notify"
      ]
    },
    "event": {
      "type": "string",
      "enum": [
        "level_approved",
        "approved",
        "rejected"
      ]
    },
    "level": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "sending",
        "posted",
        "failed",
        "not_sent",
        "timeout",
        "no_rule",
        "skipped"
      ]
    },
    "code": {
      "type": [
        "string",
        "null"
      ]
    },
    "message": {
      "type": [
        "string",
        "null"
      ]
    },
    "bankReference": {
      "type": [
        "string",
        "null"
      ]
    },
    "externalId": {
      "type": [
        "string",
        "null"
      ]
    },
    "at": {
      "type": "string"
    },
    "break": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "ref"
      ],
      "additionalProperties": false
    },
    "recon": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "amount": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "minor": {
              "type": "string"
            },
            "currency": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "minor",
            "currency"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "connector": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "attempts": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "group": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "items": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "id",
            "items"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "action",
    "kind",
    "event",
    "level",
    "status",
    "code",
    "message",
    "bankReference",
    "externalId",
    "at",
    "break",
    "recon",
    "amount",
    "connector",
    "attempts",
    "group"
  ],
  "additionalProperties": false
}
