{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourcePullDto",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "startedAt": {
      "type": "string"
    },
    "finishedAt": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "nothing_new",
        "failed",
        "paused"
      ]
    },
    "rows": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "added": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "quarantined": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "leftOut": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "watermark": {
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "startedAt",
    "finishedAt",
    "status",
    "rows",
    "added",
    "quarantined",
    "leftOut",
    "watermark",
    "error"
  ],
  "additionalProperties": false
}
