{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResultListQuery",
  "type": "object",
  "properties": {
    "page": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "pageSize": {
      "default": 15,
      "enum": [
        15,
        25,
        50,
        100
      ],
      "type": "number"
    },
    "q": {
      "type": "string",
      "maxLength": 200
    },
    "sort": {
      "type": "string",
      "enum": [
        "businessDate",
        "-businessDate",
        "status",
        "-status",
        "amountA",
        "-amountA",
        "ref",
        "-ref"
      ]
    },
    "dateFrom": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "dateTo": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "result": {
      "anyOf": [
        {
          "type": "string",
          "const": ""
        },
        {
          "type": "string",
          "enum": [
            "posting_failed",
            "posting_in_progress",
            "posting_skipped",
            "waiting_approval",
            "posted",
            "written_off",
            "adjusted",
            "closed",
            "force_matched",
            "matched_by_hand",
            "matched_late",
            "suggested",
            "matched",
            "unmatch",
            "waiting_counterpart"
          ]
        },
        {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "posting_failed",
              "posting_in_progress",
              "posting_skipped",
              "waiting_approval",
              "posted",
              "written_off",
              "adjusted",
              "closed",
              "force_matched",
              "matched_by_hand",
              "matched_late",
              "suggested",
              "matched",
              "unmatch",
              "waiting_counterpart"
            ]
          }
        }
      ]
    },
    "sideA": {
      "anyOf": [
        {
          "type": "string",
          "const": ""
        },
        {
          "type": "string",
          "enum": [
            "in_group",
            "suggested",
            "unmatch",
            "open",
            "closed",
            "none"
          ]
        },
        {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "in_group",
              "suggested",
              "unmatch",
              "open",
              "closed",
              "none"
            ]
          }
        }
      ]
    },
    "sideB": {
      "anyOf": [
        {
          "type": "string",
          "const": ""
        },
        {
          "type": "string",
          "enum": [
            "in_group",
            "suggested",
            "unmatch",
            "open",
            "closed",
            "none"
          ]
        },
        {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "in_group",
              "suggested",
              "unmatch",
              "open",
              "closed",
              "none"
            ]
          }
        }
      ]
    }
  }
}
