{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImportHistoryListQuery",
  "type": "object",
  "properties": {
    "page": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "pageSize": {
      "default": 15,
      "enum": [
        15,
        25,
        50,
        100
      ],
      "type": "number"
    },
    "q": {
      "type": "string",
      "maxLength": 200
    },
    "sort": {
      "type": "string",
      "enum": [
        "createdAt",
        "-createdAt",
        "fileDate",
        "-fileDate"
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "PROCESSING",
        "IMPORTED",
        "FAILED",
        "SUPERSEDED",
        "RERUN"
      ]
    }
  }
}
