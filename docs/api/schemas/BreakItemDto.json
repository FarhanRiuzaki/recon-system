{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BreakItemDto",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "side": {
      "type": "string",
      "enum": [
        "a",
        "b"
      ]
    },
    "businessDate": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "matched",
        "suggested",
        "break",
        "closed",
        "not_required"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "amountMinor": {
      "type": [
        "string",
        "null"
      ]
    },
    "signedMinor": {
      "type": [
        "string",
        "null"
      ]
    },
    "direction": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "debit",
            "credit"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "currency": {
      "type": [
        "string",
        "null"
      ]
    },
    "eventTime": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "side",
    "businessDate",
    "status",
    "reason",
    "ref",
    "amountMinor",
    "signedMinor",
    "direction",
    "currency",
    "eventTime",
    "source"
  ],
  "additionalProperties": false
}
