                "required": [
                  "matched",
                  "suggested",
                  "broken",
                  "brokenRefs"
                ],
                "additionalProperties": false
              }
            },
            "open": {
              "type": "object",
              "properties": {
                "a": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "b": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "a",
                "b"
              ],
              "additionalProperties": false
            },
            "breaks": {
              "type": "object",
              "properties": {
                "a": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "b": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "a",
                "b"
              ],
              "additionalProperties": false
            },
            "items": {
              "type": "object",
              "properties": {
                "a": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "b": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "a",
                "b"
              ],
              "additionalProperties": false
            },
            "breakReasons": {
              "type": "object",
              "propertyNames": {
                "type": "string"
