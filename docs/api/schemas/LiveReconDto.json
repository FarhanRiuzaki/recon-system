{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LiveReconDto",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "sides": {
      "type": "array",
      "prefixItems": [
        {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
            },
            "sourceId": {
              "type": "string"
            }
          },
          "required": [
            "label",
            "sourceId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
            },
            "sourceId": {
              "type": "string"
            }
          },
          "required": [
            "label",
            "sourceId"
          ],
          "additionalProperties": false
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "schedule": {
      "type": "object",
      "properties": {
        "business_date_offset": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "every_minutes": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "business_date_offset",
        "from",
        "to",
        "every_minutes"
      ],
      "additionalProperties": false
    },
    "date": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "open",
        "prepared",
        "signed"
      ]
    },
    "day": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "date": {
              "type": "string"
            },
            "passes": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "matched": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "suggested": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "broken": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "brokenRefs": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
