                "a": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "b": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "a",
                "b"
              ],
              "additionalProperties": false
            },
            "closed": {
              "type": "boolean"
            }
          },
          "required": [
            "date",
            "passes",
            "open",
            "breaks",
            "closed"
          ],
          "additionalProperties": false
