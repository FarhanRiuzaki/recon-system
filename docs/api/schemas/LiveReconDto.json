      ]
    },
    "runAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "lastSuccessAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "stale": {
      "type": "boolean"
    },
    "alertedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "running": {
      "anyOf": [
        {
          "type": "object",
