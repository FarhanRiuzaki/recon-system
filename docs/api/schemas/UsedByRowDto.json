{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UsedByRowDto",
  "type": "object",
  "properties": {
    "reconId": {
      "type": "string"
    },
    "reconName": {
      "type": "string"
    },
    "change": {
      "type": "string",
      "enum": [
        "posting",
        "force_match",
        "write_off",
        "unmatch"
      ]
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reconVersion": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "reconStatus": {
      "type": "string",
      "enum": [
        "published",
        "draft",
        "in_review"
      ]
    },
    "pinned": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "outdated": {
      "type": "boolean"
    }
  },
  "required": [
    "reconId",
    "reconName",
    "change",
    "rules",
    "reconVersion",
    "reconStatus",
    "pinned",
    "outdated"
  ],
  "additionalProperties": false
}
