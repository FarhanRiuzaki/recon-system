{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LiveSourceDto",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "health": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "healthy",
                "degraded",
                "down"
              ]
            },
            "businessDate": {
              "type": "string"
            },
            "lagSeconds": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "completeThrough": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "missingDate": {
              "type": [
                "string",
                "null"
              ]
            },
            "lastError": {
              "type": [
                "string",
                "null"
              ]
            },
            "lastReadAt": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "state",
            "businessDate",
            "lagSeconds",
            "completeThrough",
            "reason",
            "missingDate",
            "lastError",
            "lastReadAt"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "rowsToday": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "name",
    "health",
    "rowsToday"
  ],
  "additionalProperties": false
}
