{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SaveChainBody",
  "type": "object",
  "properties": {
    "spec": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "levels": {
          "minItems": 1,
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 80
              },
              "groups": {
                "minItems": 1,
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "spaceRoles": {
                      "maxItems": 7,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "space_admin",
                          "source_admin",
                          "config_maker",
                          "config_checker",
                          "operator",
                          "reviewer",
                          "viewer"
                        ]
                      }
                    },
                    "globalRoles": {
                      "maxItems": 20,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                      }
                    },
                    "users": {
                      "maxItems": 20,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      }
                    },
                    "need": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "any"
                            }
                          },
                          "required": [
                            "kind"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "all"
                            }
                          },
                          "required": [
                            "kind"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "count"
                            },
                            "n": {
                              "type": "integer",
                              "minimum": 2,
                              "maximum": 20
                            }
                          },
                          "required": [
                            "kind",
                            "n"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "required": [
                    "spaceRoles",
                    "globalRoles",
                    "users",
                    "need"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "name",
              "groups"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "name",
        "levels"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "spec"
  ],
  "additionalProperties": false
}
