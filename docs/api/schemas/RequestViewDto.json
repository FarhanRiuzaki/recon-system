{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RequestViewDto",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "posting",
        "force_match",
        "write_off",
        "unmatch"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "cancelled"
      ]
    },
    "note": {
      "type": "string"
    },
    "ruleName": {
      "type": [
        "string",
        "null"
      ]
    },
    "workflowName": {
      "type": [
        "string",
        "null"
      ]
    },
    "requester": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "requestedAt": {
      "type": "string"
    },
    "currentLevel": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "done",
              "waiting",
              "next",
              "rejected"
            ]
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "need": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "any",
                        "all",
                        "count"
                      ]
                    },
                    "n": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false
                },
                "approvals": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "user": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "name"
                        ],
                        "additionalProperties": false
                      },
                      "at": {
                        "type": "string"
                      },
                      "note": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "user",
                      "at",
                      "note"
                    ],
                    "additionalProperties": false
                  }
                },
                "left": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "approvers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "name"
                    ],
                    "additionalProperties": false
                  }
                },
                "short": {
                  "type": "boolean"
                }
              },
              "required": [
                "need",
                "approvals",
                "left",
                "approvers",
                "short"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "state",
          "groups"
        ],
        "additionalProperties": false
      }
    },
    "rejection": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "user": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "id",
                "name"
              ],
              "additionalProperties": false
            },
            "at": {
              "type": "string"
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            },
            "level": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "user",
            "at",
            "note",
            "level"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "override": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "user": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "id",
                "name"
              ],
              "additionalProperties": false
            },
            "at": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "user",
            "at",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "blocked": {
      "type": [
        "string",
        "null"
      ]
    },
    "canOverride": {
      "type": "boolean"
    },
    "canCancel": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "kind",
    "status",
    "note",
    "ruleName",
    "workflowName",
    "requester",
    "requestedAt",
    "currentLevel",
    "levels",
    "rejection",
    "override",
    "blocked",
    "canOverride",
    "canCancel"
  ],
  "additionalProperties": false
}
