{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ColumnContent",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "field"
        },
        "ref": {
          "type": "string",
          "pattern": "^(a|b):[a-z][a-z0-9_.]*$|^recon:[A-Za-z_]+$|^recap:[a-z_]+$"
        },
        "fallback": {
          "type": "string",
          "pattern": "^(a|b):[a-z][a-z0-9_.]*$|^recon:[A-Za-z_]+$|^recap:[a-z_]+$"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "formula"
        },
        "cel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "kind",
        "cel"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "text"
        },
        "text": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "rownum"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    }
  ]
}
