{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InboxFileDto",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "size": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "modifiedAt": {
      "type": "string"
    },
    "uploadedBy": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "uploadedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string"
          },
          "sourceName": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "waiting",
              "ingested",
              "duplicate",
              "failed"
            ]
          },
          "rowsIn": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "rowsQuarantined": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "sourceId",
          "sourceName",
          "state",
          "rowsIn",
          "rowsQuarantined"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "name",
    "size",
    "modifiedAt",
    "uploadedBy",
    "uploadedAt",
    "sources"
  ],
  "additionalProperties": false
}
