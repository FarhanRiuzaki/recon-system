        "string",
        "null"
      ]
    },
    "currency": {
      "type": [
        "string",
        "null"
      ]
    },
    "direction": {
      "type": [
        "string",
        "null"
      ]
    },
    "eventTime": {
      "type": [
        "string",
        "null"
      ]
    },
    "extRef": {
      "type": [
        "string",
        "null"
      ]
