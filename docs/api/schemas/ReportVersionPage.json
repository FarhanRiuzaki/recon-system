                                "yyyy-MM-dd",
                                "yyyyMMdd",
                                "ddMMyyyy",
                                "dd MMM yyyy",
                                "dd-MM-yyyy",
                                "MM/dd/yyyy"
                              ]
                            }
                          },
                          "required": [
                            "kind",
                            "pattern"
