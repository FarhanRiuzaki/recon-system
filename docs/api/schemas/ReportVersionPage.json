                  "encoding": {
                    "type": "string",
                    "enum": [
                      "utf8",
                      "ascii"
                    ]
                  },
                  "groupLines": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "format",
                  "fileName",
                  "masking",
                  "csv",
                  "lineEnding",
                  "encoding",
                  "groupLines"
