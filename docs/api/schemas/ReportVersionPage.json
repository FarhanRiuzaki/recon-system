    "page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "pageSize": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "totalCapped": {
      "type": "boolean"
    }
  },
  "required": [
    "items",
    "total",
    "page",
    "pageSize"
  ],
  "additionalProperties": false
}
