                                    "kind",
                                    "text"
                                  ],
                                  "additionalProperties": false
                                },
                                {
                                  "type": "object",
                                  "properties": {
                                    "kind": {
                                      "type": "string",
                                      "const": "field"
                                    },
                                    "ref": {
                                      "type": "string",
                                      "pattern": "^(a|b|item):[a-z][a-z0-9_.]*$|^recon:[A-Za-z_]+$|^recap:[a-z_]+$"
                                    }
                                  },
                                  "required": [
                                    "kind",
                                    "ref"
                                  ],
                                  "additionalProperties": false
                                },
                                {
                                  "type": "object",
                                  "properties": {
                                    "kind": {
                                      "type": "string",
                                      "const": "count"
                                    }
