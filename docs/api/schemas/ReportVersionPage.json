                  "masking": {
                    "type": "string",
                    "enum": [
                      "masked",
                      "full"
                    ]
                  },
                  "csv": {
                    "type": "object",
                    "properties": {
                      "delimiter": {
                        "type": "string",
                        "enum": [
                          ",",
                          ";",
                          "\t",
                          "|"
                        ]
                      },
                      "quote": {
                        "type": "string",
                        "enum": [
                          "auto",
                          "all"
                        ]
                      }
