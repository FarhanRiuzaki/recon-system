          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "templateId",
          "version",
          "status",
          "spec",
          "madeBy",
          "approvedBy",
          "updatedAt",
          "decidedAt",
          "note"
        ],
        "additionalProperties": false
      }
