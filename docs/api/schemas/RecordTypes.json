{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RecordTypes",
  "type": "object",
  "properties": {
    "marker": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "prefix"
            },
            "length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            }
          },
          "required": [
            "kind",
            "length"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "column"
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 499
            }
          },
          "required": [
            "kind",
            "index"
          ],
          "additionalProperties": false
        }
      ]
    },
    "types": {
      "minItems": 2,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "role": {
            "type": "string",
            "enum": [
              "header",
              "detail",
              "skip"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "columns": {
            "minItems": 1,
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100000
                },
                "length": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                }
              },
              "required": [
                "start",
                "length"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "code",
          "role",
          "count"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "marker",
    "types"
  ],
  "additionalProperties": false
}
