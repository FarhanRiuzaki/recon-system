{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReconWarning",
  "type": "object",
  "properties": {
    "step": {
      "type": "string",
      "enum": [
        "sources",
        "matching",
        "schedule",
        "approval"
      ]
    },
    "text": {
      "type": "string"
    },
    "pass": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "change": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "posting",
            "force_match",
            "write_off",
            "unmatch"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "step",
    "text",
    "pass",
    "change"
  ],
  "additionalProperties": false
}
