{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReplaceSecretsBody",
  "type": "object",
  "properties": {
    "environment": {
      "type": "string",
      "enum": [
        "dev",
        "prod"
      ]
    },
    "clientId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "clientSecret": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "publicKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "caBundle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60000
    }
  },
  "required": [
    "environment"
  ],
  "additionalProperties": false
}
