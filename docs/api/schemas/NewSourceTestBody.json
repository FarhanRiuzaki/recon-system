{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NewSourceTestBody",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "file_inbox"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "pattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "required": [
        "kind",
        "path",
        "pattern"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "db_watermark",
            "db_snapshot"
          ]
        },
        "connection": {
          "type": "object",
          "properties": {
            "engine": {
              "type": "string",
              "enum": [
                "postgres",
                "mysql",
                "mssql",
                "oracle"
              ]
            },
            "host": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "database": {
              "type": "string",
              "maxLength": 128
            },
            "user": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "password": {
              "type": "string",
              "maxLength": 1024
            },
            "options": {
              "default": {},
              "type": "object",
              "properties": {
                "tls": {
                  "default": false,
                  "type": "boolean"
                },
                "connectTimeoutSeconds": {
                  "default": 15,
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 120
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "engine",
            "host",
            "port",
            "database",
            "user"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "connection"
      ],
      "additionalProperties": false
    }
  ]
}
