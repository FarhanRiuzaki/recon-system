            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "space_admin",
                "source_admin",
                "config_maker",
                "config_checker",
                "operator",
                "reviewer",
                "viewer"
              ]
            }
          },
          "active": {
            "type": "boolean"
          },
          "lastSignInAt": {
            "type": [
              "string",
