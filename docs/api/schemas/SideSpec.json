{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SideSpec",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "enum": [
        "a",
        "b"
      ]
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "source_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "filter": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "pattern": "^(ext_ref|account_ref|amount_minor|currency|direction|event_time|business_date|attrs\\.[a-z][a-z0-9_]{0,62})$"
              },
              "op": {
                "type": "string",
                "enum": [
                  "eq",
                  "ne"
                ]
              },
              "value": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": [
              "field",
              "op",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "pattern": "^(ext_ref|account_ref|amount_minor|currency|direction|event_time|business_date|attrs\\.[a-z][a-z0-9_]{0,62})$"
              },
              "op": {
                "type": "string",
                "enum": [
                  "in",
                  "not_in"
                ]
              },
              "values": {
                "minItems": 1,
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 200
                }
              }
            },
            "required": [
              "field",
              "op",
              "values"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "pattern": "^(ext_ref|account_ref|amount_minor|currency|direction|event_time|business_date|attrs\\.[a-z][a-z0-9_]{0,62})$"
              },
              "op": {
                "type": "string",
                "enum": [
                  "is_null",
                  "not_null"
                ]
              }
            },
            "required": [
              "field",
              "op"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "amount_sign": {
      "default": "as_is",
      "type": "string",
      "enum": [
        "as_is",
        "negate"
      ]
    }
  },
  "required": [
    "key",
    "label",
    "source_id",
    "filter",
    "amount_sign"
  ],
  "additionalProperties": false
}
