{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConnectionTestDto",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "message": {
      "type": "string"
    },
    "code": {
      "type": [
        "string",
        "null"
      ]
    },
    "field": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "host",
            "port",
            "username",
            "password",
            "database",
            "tls"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "ok",
    "message",
    "code",
    "field",
    "version"
  ],
  "additionalProperties": false
}
