                    "type": "string"
                  },
                  "extRef": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "amountMinor": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "side",
                  "recordId",
                  "extRef",
                  "amountMinor"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "id",
            "passNo",
            "kind",
            "members"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "published": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "passNo": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
