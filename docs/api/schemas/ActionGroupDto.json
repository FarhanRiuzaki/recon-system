{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ActionGroupDto",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "configId": {
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "label",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "at": {
      "type": "string",
      "enum": [
        "cutoff",
        "day_close"
      ]
    },
    "closesAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "items": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "id",
    "configId",
    "period",
    "keys",
    "at",
    "closesAt",
    "items"
  ],
  "additionalProperties": false
}
