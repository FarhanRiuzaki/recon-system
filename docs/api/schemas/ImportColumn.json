{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImportColumn",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,62}$"
    },
    "type": {
      "type": "string",
      "enum": [
        "varchar",
        "char",
        "numeric",
        "integer",
        "bigint",
        "date",
        "time",
        "timestamptz"
      ]
    },
    "length": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10485760
    },
    "precision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 38
    },
    "scale": {
      "type": "integer",
      "minimum": 0,
      "maximum": 38
    },
    "required": {
      "type": "boolean"
    },
    "allowed": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    }
  },
  "required": [
    "name",
    "type",
    "required"
  ],
  "additionalProperties": false
}
