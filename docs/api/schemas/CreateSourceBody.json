{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreateSourceBody",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "kind": {
      "type": "string",
      "enum": [
        "db_watermark",
        "db_snapshot",
        "file_inbox"
      ]
    },
    "connection": {
      "type": "object",
      "properties": {
        "engine": {
          "type": "string",
          "enum": [
            "postgres",
            "mysql",
            "mssql",
            "oracle"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "database": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "user": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "password": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "options": {
          "default": {},
          "type": "object",
          "properties": {
            "tls": {
              "default": false,
              "type": "boolean"
            },
            "connectTimeoutSeconds": {
              "default": 15,
              "type": "integer",
              "minimum": 1,
              "maximum": 120
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "engine",
        "host",
        "port",
        "database",
        "user",
        "password"
      ],
      "additionalProperties": false
    },
    "draft": {
      "type": "boolean"
    }
  },
  "required": [
    "code",
    "name",
    "kind"
  ],
  "additionalProperties": false
}
