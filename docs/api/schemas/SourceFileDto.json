{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceFileDto",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "sha256": {
      "type": "string"
    },
    "size": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "ingested",
        "rejected",
        "failed"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "versionOf": {
      "type": [
        "string",
        "null"
      ]
    },
    "businessDate": {
      "type": [
        "string",
        "null"
      ]
    },
    "rowsTotal": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "rowsOk": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "rowsNew": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "rowsQuarantined": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "receivedAt": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "sha256",
    "size",
    "status",
    "reason",
    "version",
    "versionOf",
    "businessDate",
    "rowsTotal",
    "rowsOk",
    "rowsNew",
    "rowsQuarantined",
    "receivedAt"
  ],
  "additionalProperties": false
}
