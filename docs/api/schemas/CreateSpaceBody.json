{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreateSpaceBody",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[a-z0-9-]{2,32}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    }
  },
  "required": [
    "code",
    "name"
  ],
  "additionalProperties": false
}
