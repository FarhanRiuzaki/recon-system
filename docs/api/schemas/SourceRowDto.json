{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceRowDto",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "spaceId": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "db_watermark",
        "db_snapshot",
        "file_inbox"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused"
      ]
    },
    "shared": {
      "type": "boolean"
    },
    "publishedVersion": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "owner": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "spaceId": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "spaceId",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "health": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "healthy",
                "degraded",
                "down"
              ]
            },
            "businessDate": {
              "type": "string"
            },
            "lagSeconds": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "completeThrough": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "missingDate": {
              "type": [
                "string",
                "null"
              ]
            },
            "lastError": {
              "type": [
                "string",
                "null"
              ]
            },
            "lastReadAt": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "state",
            "businessDate",
            "lagSeconds",
            "completeThrough",
            "reason",
            "missingDate",
            "lastError",
            "lastReadAt"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "rowsToday": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "quarantinedToday": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "engine": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "postgres",
            "mysql",
            "mssql",
            "oracle"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "server": {
      "type": [
        "string",
        "null"
      ]
    },
    "reads": {
      "type": [
        "string",
        "null"
      ]
    },
    "usedByCount": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "pending": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "version": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "status": {
              "type": "string",
              "enum": [
                "draft",
                "in_review"
              ]
            }
          },
          "required": [
            "version",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "recent": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      }
    },
    "lastPull": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "at": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "new",
                "nothing_new",
                "failed",
                "paused"
              ]
            },
            "added": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "leftOut": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "quarantined": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "error": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "at",
            "status",
            "added",
            "leftOut",
            "quarantined",
            "error"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "nextRunAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "spaceId",
    "code",
    "name",
    "kind",
    "status",
    "shared",
    "publishedVersion",
    "owner",
    "health",
    "rowsToday",
    "quarantinedToday",
    "engine",
    "server",
    "reads",
    "usedByCount",
    "pending",
    "recent",
    "lastPull",
    "nextRunAt",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}
