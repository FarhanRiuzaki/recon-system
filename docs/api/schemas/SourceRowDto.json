{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceRowDto",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "spaceId": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "db_watermark",
        "db_snapshot",
        "file_inbox"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused"
      ]
    },
    "shared": {
      "type": "boolean"
    },
    "publishedVersion": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "owner": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "spaceId": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "spaceId",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "health": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "healthy",
                "degraded",
                "down"
              ]
            },
            "businessDate": {
              "type": "string"
            },
            "lagSeconds": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "completeThrough": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "lastError": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "state",
            "businessDate",
            "lagSeconds",
            "completeThrough",
            "reason",
            "lastError"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "rowsToday": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "quarantinedToday": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "spaceId",
    "code",
    "name",
    "kind",
    "status",
    "shared",
    "publishedVersion",
    "owner",
    "health",
    "rowsToday",
    "quarantinedToday",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}
