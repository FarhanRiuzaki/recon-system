{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceRowDto",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "spaceId": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "db_watermark",
        "db_snapshot",
        "file_inbox"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused"
      ]
    },
    "shared": {
      "type": "boolean"
    },
    "publishedVersion": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "spaceId",
    "code",
    "name",
    "kind",
    "status",
    "shared",
    "publishedVersion",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}
