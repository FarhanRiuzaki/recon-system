{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RulesListDto",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "trigger": {
            "type": "string",
            "enum": [
              "force_match",
              "unmatch",
              "write_off"
            ]
          },
          "published": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "rules": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "otherwise": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "decidedAt": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "version",
                  "rules",
                  "otherwise",
                  "decidedAt"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "open": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "draft",
                      "in_review"
                    ]
                  },
                  "updatedAt": {
                    "type": "string"
                  }
                },
                "required": [
                  "version",
                  "status",
                  "updatedAt"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "trigger",
          "published",
          "open"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}
