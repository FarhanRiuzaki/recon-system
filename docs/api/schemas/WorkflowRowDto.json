{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkflowRowDto",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "force_match",
        "unmatch",
        "write_off"
      ]
    },
    "published": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "version": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "rules": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "levels": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "decidedAt": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "version",
            "rules",
            "levels",
            "decidedAt"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "open": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "version": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "status": {
              "type": "string",
              "enum": [
                "draft",
                "in_review"
              ]
            },
            "updatedAt": {
              "type": "string"
            }
          },
          "required": [
            "version",
            "status",
            "updatedAt"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "action",
    "published",
    "open"
  ],
  "additionalProperties": false
}
