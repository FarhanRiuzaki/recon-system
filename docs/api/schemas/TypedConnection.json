{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TypedConnection",
  "type": "object",
  "properties": {
    "engine": {
      "type": "string",
      "enum": [
        "postgres",
        "mysql",
        "mssql",
        "oracle"
      ]
    },
    "host": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "database": {
      "type": "string",
      "maxLength": 128
    },
    "user": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "password": {
      "type": "string",
      "maxLength": 1024
    },
    "options": {
      "type": "object",
      "properties": {
        "tls": {
          "default": false,
          "type": "boolean"
        },
        "connectTimeoutSeconds": {
          "default": 15,
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        }
      },
      "required": [
        "tls",
        "connectTimeoutSeconds"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "engine",
    "host",
    "port",
    "database",
    "user",
    "options"
  ],
  "additionalProperties": false
}
