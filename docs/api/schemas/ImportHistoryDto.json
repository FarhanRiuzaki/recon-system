{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImportHistoryDto",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "fileName": {
      "type": "string"
    },
    "fileDate": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "PROCESSING",
        "IMPORTED",
        "FAILED",
        "SUPERSEDED",
        "RERUN"
      ]
    },
    "fileSize": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "fileHash": {
      "type": "string"
    },
    "totalRows": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "insertedRows": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "duplicateInFile": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "alreadyInDb": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "replacedRows": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "previousId": {
      "type": [
        "string",
        "null"
      ]
    },
    "errorMessage": {
      "type": [
        "string",
        "null"
      ]
    },
    "startedAt": {
      "type": "string"
    },
    "finishedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "createdAt": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "fileName",
    "fileDate",
    "status",
    "fileSize",
    "fileHash",
    "totalRows",
    "insertedRows",
    "duplicateInFile",
    "alreadyInDb",
    "replacedRows",
    "previousId",
    "errorMessage",
    "startedAt",
    "finishedAt",
    "createdAt"
  ],
  "additionalProperties": false
}
