{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UsedByPage",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reconId": {
            "type": "string"
          },
          "reconName": {
            "type": "string"
          },
          "change": {
            "type": "string",
            "enum": [
              "force_match",
              "unmatch",
              "write_off"
            ]
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reconVersion": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "reconStatus": {
            "type": "string",
            "enum": [
              "published",
              "draft",
              "in_review"
            ]
          },
          "pinned": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "outdated": {
            "type": "boolean"
          }
        },
        "required": [
          "reconId",
          "reconName",
          "change",
          "rules",
          "reconVersion",
          "reconStatus",
          "pinned",
          "outdated"
        ],
        "additionalProperties": false
      }
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "pageSize": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "totalCapped": {
      "type": "boolean"
    }
  },
  "required": [
    "items",
    "total",
    "page",
    "pageSize"
  ],
  "additionalProperties": false
}
