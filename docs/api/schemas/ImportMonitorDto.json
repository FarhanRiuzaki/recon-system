{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImportMonitorDto",
  "type": "object",
  "properties": {
    "now": {
      "type": "string"
    },
    "workerAlive": {
      "type": "boolean"
    },
    "dates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "today": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "waiting",
          "not_ready",
          "imported",
          "late",
          "missing",
          "failed",
          "rerun"
        ]
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "required": [
        "waiting",
        "not_ready",
        "imported",
        "late",
        "missing",
        "failed",
        "rerun"
      ]
    },
    "feeds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "schedulerOn": {
            "type": "boolean"
          },
          "scheduler": {
            "type": "object",
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "ok",
                  "missed",
                  "stuck",
                  "lock_left",
                  "connection_failing",
                  "off"
                ]
              },
              "lastRun": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "feedId": {
                        "type": "string"
                      },
                      "trigger": {
                        "type": "string",
                        "enum": [
                          "schedule",
                          "manual"
                        ]
                      },
                      "scheduledFor": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "startedAt": {
                        "type": "string"
                      },
                      "heartbeatAt": {
                        "type": "string"
                      },
                      "finishedAt": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "running",
                          "done",
                          "failed",
                          "crashed"
                        ]
                      },
                      "dates": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "message": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "by": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "name": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "id",
                              "name"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "feedId",
                      "trigger",
                      "scheduledFor",
                      "startedAt",
                      "heartbeatAt",
                      "finishedAt",
                      "status",
                      "dates",
                      "message",
                      "by"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "nextRun": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "message": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "state",
              "lastRun",
              "nextRun",
              "message"
            ],
            "additionalProperties": false
          },
          "cells": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string"
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "waiting",
                    "not_ready",
                    "imported",
                    "late",
                    "missing",
                    "failed",
                    "rerun"
                  ]
                },
                "rows": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "at": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "message": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "date",
                "state",
                "rows",
                "at",
                "message"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "schedulerOn",
          "scheduler",
          "cells"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "now",
    "workerAlive",
    "dates",
    "today",
    "feeds"
  ],
  "additionalProperties": false
}
