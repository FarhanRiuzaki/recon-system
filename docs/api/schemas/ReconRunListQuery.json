{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReconRunListQuery",
  "type": "object",
  "properties": {
    "page": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "pageSize": {
      "default": 15,
      "enum": [
        15,
        25,
        50,
        100
      ],
      "type": "number"
    },
    "sort": {
      "type": "string",
      "enum": [
        "startedAt",
        "-startedAt"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "manual",
        "tick",
        "daily",
        "rerun",
        "simulation"
      ]
    },
    "versionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "records": {
      "type": "string",
      "const": "1"
    }
  }
}
